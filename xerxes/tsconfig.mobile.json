{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "src/mobile/**/*.ts",
    "src/mobile/**/*.tsx",
    "src/client/**/*.ts",
    "src/hub/protocol.ts",
    "src/auth/usageView.ts"
  ],
  "exclude": ["src/mobile/__tests__"]
}
